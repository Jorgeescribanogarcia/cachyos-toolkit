MSG_EN[num_kde5]="KDE (Plasma 5) configured to turn Num Lock on at login"
MSG_EN[num_no_kwrite]="kwriteconfig not available; skipping the KDE configuration."
MSG_EN[num_installing]="Installing 'numlockx' (official repos) to apply it live…"
MSG_EN[num_installed]="numlockx installed"
MSG_EN[num_install_fail]="Could not install numlockx; Num Lock will turn on at the next login."
MSG_EN[num_live]="Num Lock turned on in the current session"
MSG_EN[num_next_login]="It will turn on at the next login."
MSG_EN[wifi_title]="WiFi fix (disconnections)"
MSG_EN[wifi_detected]="WiFi interface detected: %s (driver: %s)"
MSG_EN[wifi_unknown]="unknown"
MSG_EN[wifi_none]="No WiFi interface detected; skipping this fix."
MSG_EN[wifi_ps_written]="Wrote wifi-powersave-off.conf"
MSG_EN[wifi_ps_ok]="wifi-powersave-off.conf was already correct"
MSG_EN[wifi_ps_applying]="Applying power-save off in NetworkManager…"
MSG_EN[wifi_nm_reloaded]="NetworkManager reloaded"
MSG_EN[wifi_not_rtw88_1]="The '%s' driver is not from the rtw88 family; not applying the"
MSG_EN[wifi_not_rtw88_2]="chip-specific tweaks (only the generic power-save off was left)."
MSG_EN[wifi_rtw_written]="Wrote rtw88.conf"
MSG_EN[wifi_rtw_ok]="rtw88.conf was already correct"
MSG_EN[wifi_initramfs]="Regenerating initramfs (mkinitcpio -P)…"
MSG_EN[wifi_initramfs_ok]="initramfs regenerated"
