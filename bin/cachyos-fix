MSG_ES[st_title]="Estado actual"
MSG_ES[st_kbd_sys]="   Teclado (sistema) : X11 Layout = %s  (esperado: es)\n"
MSG_ES[st_kbd_xwl]="   Teclado (Xwayland): layout = %s  (esperado: es)\n"
MSG_ES[st_kbd_nox]="   Teclado (Xwayland): sin sesión X activa\n"
MSG_ES[st_num_on]="   Bloq Num (KDE)    : encender al iniciar (0)  ✔\n"
MSG_ES[st_num_off]="   Bloq Num (KDE)    : apagar al iniciar (1)\n"
MSG_ES[st_num_unset]="   Bloq Num (KDE)    : sin fijar (esperado: 0=encender)\n"
MSG_ES[st_wifi]="   WiFi              : %s (driver: %s)\n"
MSG_ES[st_wifi_ps]="   WiFi power_save   : %s\n"
MSG_ES[st_aspm]="   disable_aspm      : %s  (esperado: Y)\n"
MSG_ES[st_lps]="   disable_lps_deep  : %s  (esperado: Y)\n"
MSG_ES[st_wifi_none]="   WiFi              : no detectado\n"
MSG_ES[unknown_opt]="Opción desconocida: %s"
MSG_ES[usage]="Usa: cachyos-fix [all|teclado|numlock|wifi|mirrors|estado]"

t() {
  local key="$1"
  local -n _cat="MSG_${UI_LANG^^}"
  local v="${_cat[$key]:-}"
  [ -n "$v" ] || v="${MSG_EN[$key]:-$key}"
  printf '%s' "$v"
}

# ---------- pretty output ----------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '   \033[1;32m✔\033[0m %s\n' "$*"; }
warn() { printf '   \033[1;33m!\033[0m %s\n' "$*"; }
err()  { printf '   \033[1;31m✗\033[0m %s\n' "$*" >&2; }

# ---------- guards ----------
if [ "$(id -u)" -eq 0 ]; then
  err "$(t err_root_1)"
  err "$(t err_root_2)"
  exit 1
fi

# Write a system file (via sudo) only if it changes. Returns 0 if it changed.
write_root_file() {
  local path="$1" content="$2"
  if printf '%s\n' "$content" | sudo cmp -s - "$path" 2>/dev/null; then
    return 1   # already identical
  fi
  printf '%s\n' "$content" | sudo tee "$path" >/dev/null
  return 0     # written/changed
}

# ==========================================================
#  FIX 1 — Keyboard: force a layout (incl. Xwayland)
# ==========================================================
# $1 = layout code (es, us, fr, latam…). Defaults to 'es'.
fix_keyboard() {
  local layout="${1:-es}"
  log "$(printf "$(t kbd_title)" "$layout")"

  # 1) SYSTEM LEVEL (the main part): sets the default X layout in
  #    /etc/X11/xorg.conf.d/00-keyboard.conf. Xwayland reads it at startup,
  #    before any app, and it persists across sessions without an autostart.
  if command -v localectl >/dev/null 2>&1; then
    local cur
    cur=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}')
    if [ "$cur" = "$layout" ]; then
      ok "$(printf "$(t kbd_sys_same)" "$layout")"
    elif sudo localectl set-x11-keymap "$layout"; then
      ok "$(printf "$(t kbd_sys_set)" "$layout")"
    else
      warn "$(t kbd_sys_fail)"
    fi
  else
    warn "$(t kbd_no_localectl)"
  fi

  # 2) SAFETY NET: on KDE Wayland, KWin can override the above for Xwayland.
  #    An autostart with 'setxkbmap' guarantees it on every login.
  local autostart="$HOME/.config/autostart/fix-keyboard-layout.desktop"
  mkdir -p "$HOME/.config/autostart"
  cat > "$autostart" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$(printf "$(t kbd_desktop_name)" "$layout")
Comment=$(printf "$(t kbd_desktop_comment)" "$layout")
Exec=setxkbmap $layout
Terminal=false
X-KDE-autostart-phase=2
DESKTOP
  ok "$(printf "$(t kbd_autostart)" "$autostart")"
  # Clean up the old autostart name (previous versions hardcoded 'es').
  rm -f "$HOME/.config/autostart/fix-keyboard-es.desktop" 2>/dev/null

  # 3) LIVE: apply it right now in the current session (no relogin).
  if command -v setxkbmap >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    setxkbmap "$layout" 2>/dev/null && ok "$(printf "$(t kbd_live)" "$layout")"
  else
    warn "$(t kbd_no_x)"
  fi
}

# ==========================================================
#  FIX 2 — Num Lock: keep it always on
# ==========================================================
fix_numlock() {
  log "$(t num_title)"

  # 1) KDE Plasma: turn Num Lock on at login (kcminputrc).
  #    NumLock=0 -> on ; 1 -> off ; 2 -> unchanged.
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kcminputrc --group Keyboard --key NumLock 0 \
      && ok "$(t num_kde6)"
  elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kwriteconfig5 --file kcminputrc --group Keyboard --key NumLock 0 \
      && ok "$(t num_kde5)"
  else
    warn "$(t num_no_kwrite)"
  fi

  # 2) 'numlockx' lets us apply it live. It is in the official repos.
  if ! command -v numlockx >/dev/null 2>&1; then
    log "$(t num_installing)"
    sudo pacman -S --needed --noconfirm numlockx \
      && ok "$(t num_installed)" \
      || warn "$(t num_install_fail)"
  fi

  # 3) Apply it right now in the current session (no relogin).
  if command -v numlockx >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    numlockx on 2>/dev/null && ok "$(t num_live)"
  else
    warn "$(t num_next_login)"
  fi
}

# ==========================================================
#  WiFi detection (interface + driver), hardware-independent
# ==========================================================
# Prints "iface driver" of the 1st wireless interface; empty if none.
detect_wifi() {
  local dev iface drv
  for dev in /sys/class/net/*/wireless; do
    [ -e "$dev" ] || continue
    iface=$(basename "$(dirname "$dev")")
    drv=""
    if [ -e "/sys/class/net/$iface/device/driver" ]; then
      drv=$(basename "$(readlink -f "/sys/class/net/$iface/device/driver")")
    fi
    printf '%s %s\n' "$iface" "$drv"
    return 0
  done
  return 1
}

# ==========================================================
#  FIX 3 — WiFi: disconnections. Detects the driver and adapts the fix.
#  Turning power-save off is generic; the module parameters and the driver
#  reload only apply to the rtw88 family (RTL8822/8821…), which is the one
#  affected by the BEACON-LOSS bursts.
# ==========================================================
fix_wifi() {
  log "$(t wifi_title)"

  local info iface driver
  if info=$(detect_wifi); then
    iface=${info%% *}; driver=${info##* }
    ok "$(printf "$(t wifi_detected)" "$iface" "${driver:-$(t wifi_unknown)}")"
  else
    warn "$(t wifi_none)"
    return 0
  fi

  # 1) Turn power-save off in NetworkManager (generic: helps any WiFi).
  if write_root_file /etc/NetworkManager/conf.d/wifi-powersave-off.conf \
"[connection]
wifi.powersave = 2"; then
    ok "$(t wifi_ps_written)"
  else
    ok "$(t wifi_ps_ok)"
  fi
  log "$(t wifi_ps_applying)"
  sudo systemctl reload NetworkManager && ok "$(t wifi_nm_reloaded)"

  # 2) rtw88-family-specific part (disable_aspm / disable_lps_deep).
  if [[ "$driver" != rtw88* && "$driver" != rtw_* ]]; then
    warn "$(printf "$(t wifi_not_rtw88_1)" "$driver")"
    warn "$(t wifi_not_rtw88_2)"
    return 0
  fi

  local changed=0
  if write_root_file /etc/modprobe.d/rtw88.conf \
"options rtw88_pci disable_aspm=1
options rtw88_core disable_lps_deep=1"; then
    ok "$(t wifi_rtw_written)"; changed=1
  else
    ok "$(t wifi_rtw_ok)"
  fi

  if [ "$changed" -eq 1 ]; then
    log "$(t wifi_initramfs)"
    sudo mkinitcpio -P && ok "$(t wifi_initramfs_ok)"
  else
    ok "$(t wifi_no_initramfs)"
  fi

  local aspm lps
  aspm=$(cat /sys/module/rtw88_pci/parameters/disable_aspm 2>/dev/null || echo "?")
  lps=$(cat /sys/module/rtw88_core/parameters/disable_lps_deep 2>/dev/null || echo "?")
  if [ "$aspm" != "Y" ] || [ "$lps" != "Y" ]; then
    warn "$(printf "$(t wifi_reload)" "$driver")"
    sudo modprobe -r "$driver" rtw88_pci rtw88_core 2>/dev/null
    sudo modprobe "$driver" && ok "$(printf "$(t wifi_reloaded)" "$driver")"
  else
    ok "$(t wifi_already)"
  fi
}

# ==========================================================
#  FIX 4 — Mirrors: refresh the list and re-sync pacman
# ==========================================================
# Picks the fastest/most up-to-date mirrors and forces pacman to re-download
# the databases. Fixes the 404 errors on update when mirrors are out of sync.
fix_mirrors() {
  log "$(t mir_title)"

  local tool=""
  if command -v cachyos-rate-mirrors >/dev/null 2>&1; then
    tool="cachyos-rate-mirrors"
  elif command -v rate-mirrors >/dev/null 2>&1; then
    tool="rate-mirrors"
  elif command -v reflector >/dev/null 2>&1; then
    tool="reflector"
  fi

  if [ -z "$tool" ]; then
    warn "$(t mir_none)"
    local resp
    read -rp "$(t mir_ask_install)" resp
    case "${resp,,}" in
      n|no)
        err "$(t mir_declined)"
        return 1 ;;
      *)
        log "$(t mir_installing)"
        if sudo pacman -S --needed --noconfirm cachyos-rate-mirrors \
           && command -v cachyos-rate-mirrors >/dev/null 2>&1; then
          ok "$(t mir_installed)"
          tool="cachyos-rate-mirrors"
        else
          err "$(t mir_install_fail)"
          return 1
        fi ;;
    esac
  fi

  case "$tool" in
    cachyos-rate-mirrors|rate-mirrors)
      log "$(printf "$(t mir_reorder)" "$tool")"
      sudo "$tool" && ok "$(t mir_updated)" ;;
    reflector)
      log "$(t mir_reorder_reflector)"
      sudo reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist \
        && ok "$(t mir_updated)" ;;
  esac

  log "$(t mir_resync)"
  sudo pacman -Syy && ok "$(t mir_resynced)"

  warn "$(t mir_hint)"
}

# ==========================================================
#  STATUS
# ==========================================================
status() {
  log "$(t st_title)"
  local layout sys_layout
  if command -v localectl >/dev/null 2>&1; then
    sys_layout=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}')
    printf "$(t st_kbd_sys)" "${sys_layout:-?}"
  fi
  if command -v setxkbmap >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    layout=$(setxkbmap -query 2>/dev/null | awk '/layout/{print $2}')
    printf "$(t st_kbd_xwl)" "${layout:-?}"
  else
    printf "$(t st_kbd_nox)"
  fi
  if command -v kreadconfig6 >/dev/null 2>&1; then
    local nl; nl=$(kreadconfig6 --file kcminputrc --group Keyboard --key NumLock 2>/dev/null)
    case "$nl" in
      0) printf "$(t st_num_on)" ;;
      1) printf "$(t st_num_off)" ;;
      *) printf "$(t st_num_unset)" ;;
    esac
  fi
  local winfo wiface wdriver
  if winfo=$(detect_wifi); then
    wiface=${winfo%% *}; wdriver=${winfo##* }
    printf "$(t st_wifi)" "$wiface" "${wdriver:-?}"
    printf "$(t st_wifi_ps)" "$(iw dev "$wiface" get power_save 2>/dev/null | awk -F': ' '/Power save/{print $2}')"
    if [[ "$wdriver" == rtw88* || "$wdriver" == rtw_* ]]; then
      printf "$(t st_aspm)" "$(cat /sys/module/rtw88_pci/parameters/disable_aspm 2>/dev/null || echo '?')"
      printf "$(t st_lps)" "$(cat /sys/module/rtw88_core/parameters/disable_lps_deep 2>/dev/null || echo '?')"
    fi
  else
    printf "$(t st_wifi_none)"
  fi
}

# ==========================================================
#  main
# ==========================================================
case "${1:-all}" in
  teclado|keyboard|kb)     fix_keyboard "${2:-}" ;;
  numlock|numlk|bloqnum)   fix_numlock ;;
  wifi)                    fix_wifi ;;
  mirrors|mirror|espejos)  fix_mirrors ;;
  estado|status)           status ;;
  all|"")                  fix_keyboard; echo; fix_numlock; echo; fix_wifi; echo; status ;;
  -h|--help|help)
    sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    err "$(printf "$(t unknown_opt)" "$1")"
    err "$(t usage)"
    exit 1 ;;
esac
