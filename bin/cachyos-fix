MSG_EN[mir_updated]="Mirror list updated"
MSG_EN[mir_resync]="Re-syncing pacman databases (pacman -Syy)…"
MSG_EN[mir_resynced]="Databases re-synced"
MSG_EN[mir_hint]="Now you can update with: sudo pacman -Su"
MSG_EN[st_title]="Current status"
MSG_EN[st_kbd_sys]="   Keyboard (system) : X11 Layout = %s  (expected: es)\n"
