#!/usr/bin/env bash
#
# cachyos-fix — CachyOS configuration fixes (JorgeLT)
#
# Usage:
#   cachyos-fix            # apply ALL fixes
#   cachyos-fix all        # same
#   cachyos-fix teclado [code]  # keyboard layout (default es; e.g. teclado fr)
#   cachyos-fix numlock    # only the Num Lock fix (keep it on)
#   cachyos-fix wifi       # only the WiFi fix (detects the driver)
#   cachyos-fix mirrors    # refresh the mirror list and re-sync pacman
#   cachyos-fix estado     # show the current status, without changing anything
#
# Idempotent: safe to re-run. It does not reload the WiFi driver if the fix is
# already applied (so it won't drop the connection needlessly).
#
# Bilingual output (English / Spanish): resolved from CACHYOS_LANG, then
# ~/.config/cachyos-toolkit/lang, then the system locale.
#
set -uo pipefail

# ---------- language ----------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cachyos-toolkit"
LANG_FILE="$CONFIG_DIR/lang"
UI_LANG="en"

detect_system_lang() {
  case "${LC_ALL:-}${LC_MESSAGES:-}${LANG:-}" in
    es*|*_ES*|*es_*) echo es ;;
    *) echo en ;;
  esac
}
if   [ -n "${CACHYOS_LANG:-}" ]; then UI_LANG="$CACHYOS_LANG"
elif [ -r "$LANG_FILE" ];       then UI_LANG="$(<"$LANG_FILE")"
else                                 UI_LANG="$(detect_system_lang)"; fi
case "$UI_LANG" in es|en) ;; *) UI_LANG="en" ;; esac

declare -A MSG_EN MSG_ES

MSG_EN[err_root_1]="Do not run this as root or with 'sudo cachyos-fix'."
MSG_EN[err_root_2]="Run it as a normal user: 'cachyos-fix' (it will ask for sudo when needed)."
MSG_EN[kbd_title]="Keyboard fix (layout '%s', incl. Xwayland)"
MSG_EN[kbd_sys_same]="System X layout was already '%s' (localectl)"
MSG_EN[kbd_sys_set]="System X layout set to '%s' (localectl)"
MSG_EN[kbd_sys_fail]="Could not set it with localectl; the backup below remains."
MSG_EN[kbd_no_localectl]="localectl not available; using only the backup autostart."
MSG_EN[kbd_autostart]="Backup autostart: %s"
MSG_EN[kbd_desktop_name]="Set keyboard (%s) on Xwayland"
MSG_EN[kbd_desktop_comment]="Backup: forces the '%s' layout on X11/Xwayland apps at login"
MSG_EN[kbd_live]="Applied to the current session (setxkbmap %s)"
MSG_EN[kbd_no_x]="No active Xwayland now; it will apply at the next login."
