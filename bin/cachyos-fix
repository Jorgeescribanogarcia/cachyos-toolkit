MSG_EN[unknown_opt]="Unknown option: %s"
MSG_EN[usage]="Use: cachyos-fix [all|teclado|numlock|wifi|mirrors|estado]"

MSG_ES[err_root_1]="No lo ejecutes como root ni con 'sudo cachyos-fix'."
MSG_ES[err_root_2]="Ejecútalo como usuario normal: 'cachyos-fix' (pedirá sudo cuando lo necesite)."
