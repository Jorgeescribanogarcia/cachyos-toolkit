MSG_EN[wifi_reload]="Reloading the '%s' driver — WiFi will drop for a few seconds."
MSG_EN[wifi_reloaded]="Driver '%s' reloaded with the new parameters"
MSG_EN[wifi_already]="The driver already has the parameters applied (not reloading)"
MSG_EN[mir_title]="Mirror fix (refresh list and re-sync pacman)"
MSG_EN[mir_none]="Could not find 'cachyos-rate-mirrors', 'rate-mirrors' or 'reflector'."
MSG_EN[mir_ask_install]="   Install the recommended 'cachyos-rate-mirrors' now? [Y/n]: "
MSG_EN[mir_declined]="No tool installed; exiting without changing anything."
MSG_EN[mir_installing]="Installing 'cachyos-rate-mirrors' (official repos)…"
MSG_EN[mir_installed]="'cachyos-rate-mirrors' installed"
MSG_EN[mir_install_fail]="Could not install 'cachyos-rate-mirrors'; exiting without changing anything."
MSG_EN[mir_reorder]="Reordering mirrors with '%s'…"
