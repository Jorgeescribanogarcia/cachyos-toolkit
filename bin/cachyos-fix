t() {
  local key="$1"
  local -n _cat="MSG_${UI_LANG^^}"
  local v="${_cat[$key]:-}"
  [ -n "$v" ] || v="${MSG_EN[$key]:-$key}"
  printf '%s' "$v"
}

# ---------- pretty output ----------
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '   \033[1;32m✔\033[0m %s\n' "$*"; }
warn() { printf '   \033[1;33m!\033[0m %s\n' "$*"; }
err()  { printf '   \033[1;31m✗\033[0m %s\n' "$*" >&2; }

# ---------- guards ----------
if [ "$(id -u)" -eq 0 ]; then
  err "$(t err_root_1)"
  err "$(t err_root_2)"
  exit 1
fi

# Write a system file (via sudo) only if it changes. Returns 0 if it changed.
write_root_file() {
  local path="$1" content="$2"
  if printf '%s\n' "$content" | sudo cmp -s - "$path" 2>/dev/null; then
    return 1   # already identical
  fi
  printf '%s\n' "$content" | sudo tee "$path" >/dev/null
  return 0     # written/changed
}

# ==========================================================
#  FIX 1 — Keyboard: force a layout (incl. Xwayland)
# ==========================================================
# $1 = layout code (es, us, fr, latam…). Defaults to 'es'.
fix_keyboard() {
  local layout="${1:-es}"
  log "$(printf "$(t kbd_title)" "$layout")"

  # 1) SYSTEM LEVEL (the main part): sets the default X layout in
  #    /etc/X11/xorg.conf.d/00-keyboard.conf. Xwayland reads it at startup,
  #    before any app, and it persists across sessions without an autostart.
  if command -v localectl >/dev/null 2>&1; then
    local cur
    cur=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}')
    if [ "$cur" = "$layout" ]; then
      ok "$(printf "$(t kbd_sys_same)" "$layout")"
    elif sudo localectl set-x11-keymap "$layout"; then
      ok "$(printf "$(t kbd_sys_set)" "$layout")"
    else
      warn "$(t kbd_sys_fail)"
    fi
  else
    warn "$(t kbd_no_localectl)"
  fi

  # 2) SAFETY NET: on KDE Wayland, KWin can override the above for Xwayland.
  #    An autostart with 'setxkbmap' guarantees it on every login.
  local autostart="$HOME/.config/autostart/fix-keyboard-layout.desktop"
  mkdir -p "$HOME/.config/autostart"
  cat > "$autostart" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$(printf "$(t kbd_desktop_name)" "$layout")
Comment=$(printf "$(t kbd_desktop_comment)" "$layout")
Exec=setxkbmap $layout
Terminal=false
X-KDE-autostart-phase=2
DESKTOP
  ok "$(printf "$(t kbd_autostart)" "$autostart")"
  # Clean up the old autostart name (previous versions hardcoded 'es').
  rm -f "$HOME/.config/autostart/fix-keyboard-es.desktop" 2>/dev/null

  # 3) LIVE: apply it right now in the current session (no relogin).
  if command -v setxkbmap >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    setxkbmap "$layout" 2>/dev/null && ok "$(printf "$(t kbd_live)" "$layout")"
  else
    warn "$(t kbd_no_x)"
  fi
}

# ==========================================================
#  FIX 2 — Num Lock: configure the numeric keypad behavior
# ==========================================================
# $1 = mode: on (always on), off (always off), unchanged (leave firmware/last
# state). Defaults to 'on' (backward compatible with the old fixed behavior).
fix_numlock() {
  local mode="${1:-on}"
  case "$mode" in on|off|unchanged) ;; *) mode=on ;; esac
  log "$(t num_title)"

  # 1) KDE Plasma: Num Lock state at login (kcminputrc).
  #    NumLock=0 -> on ; 1 -> off ; 2 -> unchanged.
  local kval mlabel
  case "$mode" in
    on)        kval=0; mlabel="$(t num_mode_on)" ;;
    off)       kval=1; mlabel="$(t num_mode_off)" ;;
    unchanged) kval=2; mlabel="$(t num_mode_unchanged)" ;;
  esac
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kcminputrc --group Keyboard --key NumLock "$kval" \
      && ok "$(printf "$(t num_kde_set)" "$mlabel")"
  elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kwriteconfig5 --file kcminputrc --group Keyboard --key NumLock "$kval" \
      && ok "$(printf "$(t num_kde5_set)" "$mlabel")"
  else
    warn "$(t num_no_kwrite)"
  fi

  # 'unchanged' just defers to the firmware/last state: no live change.
  if [ "$mode" = unchanged ]; then
    ok "$(t num_unchanged_note)"
    return
  fi

  # 2) 'numlockx' lets us apply it live (on/off). It is in the official repos.
  if ! command -v numlockx >/dev/null 2>&1; then
    log "$(t num_installing)"
    sudo pacman -S --needed --noconfirm numlockx \
      && ok "$(t num_installed)" \
      || warn "$(t num_install_fail)"
  fi

  # 3) Apply it right now in the current session (no relogin).
  if command -v numlockx >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    numlockx "$mode" 2>/dev/null && ok "$(t "num_live_$mode")"
  else
    warn "$(t num_next_login)"
  fi
}

# ==========================================================
#  FIX — Function keys (Fn) behavior via hid_apple fnmode
# ==========================================================
# $1 = mode: fkeys (F1–F12 first), media (multimedia first), auto. Only works
# on keyboards driven by hid_apple (Apple/«Magic» and some third-party ones);
# on most laptops the Fn behavior is set in the firmware/BIOS and is not
# OS-controllable, so we detect that and bail out instead of writing junk.
fix_fnkeys() {
  local mode="${1:-fkeys}" val mlabel
  case "$mode" in
    fkeys|f|fk) val=2; mlabel="$(t fn_mode_fkeys)" ;;
    media|m)    val=1; mlabel="$(t fn_mode_media)" ;;
    auto|a)     val=3; mlabel="$(t fn_mode_auto)" ;;
    *)          mode=fkeys; val=2; mlabel="$(t fn_mode_fkeys)" ;;
  esac
  log "$(printf "$(t fn_title)") — $mlabel"

  if [ ! -d /sys/module/hid_apple ]; then
    warn "$(t fn_not_supported)"
    return 0
  fi

  # 1) Persist across boots via a modprobe option.
  if write_root_file /etc/modprobe.d/hid_apple.conf "options hid_apple fnmode=$val"; then
    ok "$(printf "$(t fn_persist)" "$val")"
  else
    ok "$(t fn_persist_ok)"
  fi

  # 2) Apply live to the loaded module (no reboot).
  local sysf=/sys/module/hid_apple/parameters/fnmode
  if [ -e "$sysf" ] && echo "$val" | sudo tee "$sysf" >/dev/null 2>&1; then
    ok "$(printf "$(t fn_live)" "$val")"
  else
    warn "$(t fn_next_boot)"
  fi
}

# ==========================================================
#  WiFi detection (interface + driver), hardware-independent
# ==========================================================
# Prints "iface driver" of the 1st wireless interface; empty if none.
detect_wifi() {
  local dev iface drv
  for dev in /sys/class/net/*/wireless; do
    [ -e "$dev" ] || continue
    iface=$(basename "$(dirname "$dev")")
    drv=""
    if [ -e "/sys/class/net/$iface/device/driver" ]; then
      drv=$(basename "$(readlink -f "/sys/class/net/$iface/device/driver")")
    fi
    printf '%s %s\n' "$iface" "$drv"
    return 0
  done
  return 1
}

# ==========================================================
#  FIX 3 — WiFi: disconnections. Detects the driver and adapts the fix.
#  Turning power-save off is generic; the module parameters and the driver
#  reload only apply to the rtw88 family (RTL8822/8821…), which is the one
#  affected by the BEACON-LOSS bursts.
# ==========================================================
fix_wifi() {
  log "$(t wifi_title)"

  local info iface driver
  if info=$(detect_wifi); then
    iface=${info%% *}; driver=${info##* }
    ok "$(printf "$(t wifi_detected)" "$iface" "${driver:-$(t wifi_unknown)}")"
  else
    warn "$(t wifi_none)"
    return 0
  fi

  # 1) Turn power-save off in NetworkManager (generic: helps any WiFi).
  if write_root_file /etc/NetworkManager/conf.d/wifi-powersave-off.conf \
"[connection]
wifi.powersave = 2"; then
    ok "$(t wifi_ps_written)"
  else
    ok "$(t wifi_ps_ok)"
  fi
  log "$(t wifi_ps_applying)"
  sudo systemctl reload NetworkManager && ok "$(t wifi_nm_reloaded)"

  # 2) rtw88-family-specific part (disable_aspm / disable_lps_deep).
  if [[ "$driver" != rtw88* && "$driver" != rtw_* ]]; then
    warn "$(printf "$(t wifi_not_rtw88_1)" "$driver")"
    warn "$(t wifi_not_rtw88_2)"
    return 0
  fi

  local changed=0
  if write_root_file /etc/modprobe.d/rtw88.conf \
"options rtw88_pci disable_aspm=1
options rtw88_core disable_lps_deep=1"; then
    ok "$(t wifi_rtw_written)"; changed=1
  else
    ok "$(t wifi_rtw_ok)"
  fi

  if [ "$changed" -eq 1 ]; then
    log "$(t wifi_initramfs)"
    sudo mkinitcpio -P && ok "$(t wifi_initramfs_ok)"
  else
    ok "$(t wifi_no_initramfs)"
  fi

  local aspm lps
  aspm=$(cat /sys/module/rtw88_pci/parameters/disable_aspm 2>/dev/null || echo "?")
  lps=$(cat /sys/module/rtw88_core/parameters/disable_lps_deep 2>/dev/null || echo "?")
  if [ "$aspm" != "Y" ] || [ "$lps" != "Y" ]; then
    warn "$(printf "$(t wifi_reload)" "$driver")"
    sudo modprobe -r "$driver" rtw88_pci rtw88_core 2>/dev/null
    sudo modprobe "$driver" && ok "$(printf "$(t wifi_reloaded)" "$driver")"
  else
    ok "$(t wifi_already)"
  fi
}

# ==========================================================
#  FIX 4 — Mirrors: refresh the list and re-sync pacman
# ==========================================================
# Picks the fastest/most up-to-date mirrors and forces pacman to re-download
# the databases. Fixes the 404 errors on update when mirrors are out of sync.
fix_mirrors() {
  log "$(t mir_title)"

  local tool=""
  if command -v cachyos-rate-mirrors >/dev/null 2>&1; then
    tool="cachyos-rate-mirrors"
  elif command -v rate-mirrors >/dev/null 2>&1; then
    tool="rate-mirrors"
  elif command -v reflector >/dev/null 2>&1; then
    tool="reflector"
  fi

  if [ -z "$tool" ]; then
    warn "$(t mir_none)"
    local resp
    read -rp "$(t mir_ask_install)" resp
    case "${resp,,}" in
      n|no)
        err "$(t mir_declined)"
        return 1 ;;
      *)
        log "$(t mir_installing)"
        if sudo pacman -S --needed --noconfirm cachyos-rate-mirrors \
           && command -v cachyos-rate-mirrors >/dev/null 2>&1; then
          ok "$(t mir_installed)"
          tool="cachyos-rate-mirrors"
        else
          err "$(t mir_install_fail)"
          return 1
        fi ;;
    esac
  fi

  case "$tool" in
    cachyos-rate-mirrors|rate-mirrors)
      log "$(printf "$(t mir_reorder)" "$tool")"
      sudo "$tool" && ok "$(t mir_updated)" ;;
    reflector)
      log "$(t mir_reorder_reflector)"
      sudo reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist \
        && ok "$(t mir_updated)" ;;
  esac

  log "$(t mir_resync)"
  sudo pacman -Syy && ok "$(t mir_resynced)"

  warn "$(t mir_hint)"
}

# ==========================================================
#  Boot / kernel-module helpers (shared by the checks below and status)
# ==========================================================
# True if /etc/fstab declares a separate /boot partition (field 2 == /boot).
boot_in_fstab() { awk '$1!~/^#/ && $2=="/boot"{f=1} END{exit !f}' /etc/fstab 2>/dev/null; }

# Ensure /boot is usable. Prints status. Returns 0 if mounted or on root,
# 1 if it should be mounted (fstab) but could not be.
check_boot() {
  if mountpoint -q /boot; then
    ok "$(t pu_boot_mounted)"; return 0
  fi
  if boot_in_fstab; then
    warn "$(t pu_boot_unmounted)"
    log "$(t pu_boot_mounting)"
    if sudo mount /boot 2>/dev/null && mountpoint -q /boot; then
      ok "$(t pu_boot_mounted_ok)"; return 0
    fi
    err "$(t pu_boot_mount_fail)"; return 1
  fi
  ok "$(t pu_boot_on_root)"; return 0   # /boot lives on the root fs — fine
}

# Print orphan kernel-module versions, one per line: /usr/lib/modules/<ver>
# dirs left behind by kernels that are no longer installed. NEVER includes the
# running kernel.
#
# Reliability note: we do NOT use `pacman -Qo`, which canonicalizes paths and
# happily reports a *different* installed version as the owner of a leftover
# dir (so it would report zero orphans even when one exists — the exact failure
# this feature is meant to catch). Instead we read each dir's own `pkgbase`
# marker to learn its package, then confirm that that package actually owns
# THIS version's pkgbase in its file list (`pacman -Ql`). A leftover version is
# not in its package's current file list → flagged as orphan.
orphan_modules() {
  local moddir=/usr/lib/modules running d ver pkg
  running=$(uname -r)
  for d in "$moddir"/*/; do
    [ -d "$d" ] || continue
    ver=$(basename "$d")
    [ "$ver" = "$running" ] && continue
    pkg=""
    [ -f "$d/pkgbase" ] && pkg=$(cat "$d/pkgbase" 2>/dev/null)
    if [ -n "$pkg" ] && pacman -Ql "$pkg" 2>/dev/null \
         | awk -v p="/usr/lib/modules/$ver/pkgbase" '$2==p{f=1} END{exit !f}'; then
      continue   # this exact version is owned by its installed package → keep
    fi
    printf '%s\n' "$ver"
  done
}

# ==========================================================
#  FIX — Pre-update safety check (/boot mounted, stale pacman lock)
# ==========================================================
# The incident this prevents: updating with /boot unmounted (kernel image and
# on-disk modules drift apart) or with a stale db.lck left by a crashed pacman.
fix_preupdate() {
  log "$(t pu_title)"
  local safe=0

  check_boot || safe=1

  if [ -e /var/lib/pacman/db.lck ]; then
    if pgrep -x pacman >/dev/null 2>&1; then
      warn "$(t pu_lock_busy)"; safe=1   # real running transaction — never touch
    else
      warn "$(t pu_lock_stale)"
      local r; read -rp "$(t pu_lock_ask)" r
      case "${r,,}" in
        n|no) ok "$(t pu_lock_kept)" ;;
        *)    sudo rm -f /var/lib/pacman/db.lck && ok "$(t pu_lock_removed)" ;;
      esac
    fi
  else
    ok "$(t pu_lock_none)"
  fi

  if [ "$safe" -ne 0 ]; then
    err "$(t pu_abort)"; return 1
  fi
  ok "$(t pu_safe)"; return 0
}

# Safe system update: run the pre-update check first, then pacman -Syu.
fix_update() {
  fix_preupdate || { warn "$(t pu_update_skipped)"; return 1; }
  local r; read -rp "$(t pu_update_ask)" r
  case "${r,,}" in
    n|no) warn "$(t pu_update_cancelled)"; return 0 ;;
  esac
  log "$(t pu_updating)"
  sudo pacman -Syu
}

# ==========================================================
#  FIX — Repair boot: orphan modules, depmod, DKMS, initramfs
# ==========================================================
# Removes leftover /usr/lib/modules/<ver> folders of kernels that are no longer
# installed (which make DKMS and mkinitcpio try to build for kernels that do not
# exist), then rebuilds everything cleanly. The running kernel is protected.
fix_repair_boot() {
  log "$(t rb_title)"

  # A correct initramfs write needs /boot mounted.
  check_boot || { err "$(t rb_need_boot)"; return 1; }

  local running moddir=/usr/lib/modules
  running=$(uname -r)
  ok "$(printf "$(t rb_running_protected)" "$running")"

  local -a orphans=()
  mapfile -t orphans < <(orphan_modules)

  if [ "${#orphans[@]}" -gt 0 ]; then
    warn "$(t rb_orphans_found)"
    local ver
    for ver in "${orphans[@]}"; do printf '     - %s\n' "$ver"; done
    local r; read -rp "$(t rb_orphans_ask)" r
    case "${r,,}" in
      n|no) warn "$(t rb_orphans_kept)" ;;
      *)
        for ver in "${orphans[@]}"; do
          [ -n "$ver" ] && [ "$ver" != "$running" ] || continue   # paranoia
          sudo rm -rf -- "$moddir/$ver" && ok "$(printf "$(t rb_orphan_removed)" "$ver")"
        done ;;
    esac
  else
    ok "$(t rb_no_orphans)"
  fi

  # Recompute module dependencies for every remaining kernel.
  log "$(t rb_depmod)"
  local d ver
  for d in "$moddir"/*/; do
    [ -d "$d" ] || continue
    ver=$(basename "$d")
    sudo depmod "$ver" 2>/dev/null
  done
  ok "$(t rb_depmod_ok)"

  # Clean DKMS rebuild (nvidia-open-dkms, etc.) for all installed kernels.
  if command -v dkms >/dev/null 2>&1; then
    log "$(t rb_dkms)"
    if sudo dkms autoinstall; then ok "$(t rb_dkms_ok)"; else warn "$(t rb_dkms_fail)"; fi
  else
    warn "$(t rb_dkms_none)"
  fi

  # Regenerate every initramfs preset.
  log "$(t rb_initramfs)"
  if sudo mkinitcpio -P; then
    ok "$(t rb_initramfs_ok)"
  else
    err "$(t rb_initramfs_fail)"; return 1
  fi

  ok "$(t rb_done)"
}

# ==========================================================
#  FIX — View / remove obsolete (orphan) kernel modules
# ==========================================================
# Lighter than repair-boot: just lists the leftover /usr/lib/modules/<ver>
# folders of no-longer-installed kernels and offers to remove them all. The
# running kernel is protected. depmod is refreshed afterwards; the full
# DKMS/initramfs rebuild is left to 'repair-boot'.
fix_clean_kernels() {
  log "$(t ck_title)"
  local running moddir=/usr/lib/modules
  running=$(uname -r)

  local -a orphans=()
  mapfile -t orphans < <(orphan_modules)
  if [ "${#orphans[@]}" -eq 0 ]; then
    ok "$(t rb_no_orphans)"
    return 0
  fi

  warn "$(t rb_orphans_found)"
  local ver sz
  for ver in "${orphans[@]}"; do
    sz=$(du -sh "$moddir/$ver" 2>/dev/null | awk '{print $1}')
    printf '     - %s  (%s)\n' "$ver" "${sz:-?}"
  done
  ok "$(printf "$(t rb_running_protected)" "$running")"

  local r; read -rp "$(t ck_delete_all_ask)" r
  case "${r,,}" in
    s|si|sí|y|yes) ;;
    *) warn "$(t rb_orphans_kept)"; return 0 ;;
  esac

  for ver in "${orphans[@]}"; do
    [ -n "$ver" ] && [ "$ver" != "$running" ] || continue   # paranoia
    sudo rm -rf -- "$moddir/$ver" && ok "$(printf "$(t rb_orphan_removed)" "$ver")"
  done
  sudo depmod "$running" 2>/dev/null   # keep deps consistent
  ok "$(t ck_done)"
}

# ==========================================================
#  STATUS
# ==========================================================
status() {
  log "$(t st_title)"
  local layout sys_layout
  if command -v localectl >/dev/null 2>&1; then
    sys_layout=$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}')
    printf "$(t st_kbd_sys)" "${sys_layout:-?}"
  fi
  if command -v setxkbmap >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    layout=$(setxkbmap -query 2>/dev/null | awk '/layout/{print $2}')
    printf "$(t st_kbd_xwl)" "${layout:-?}"
  else
    printf "$(t st_kbd_nox)"
  fi
  if command -v kreadconfig6 >/dev/null 2>&1; then
    local nl; nl=$(kreadconfig6 --file kcminputrc --group Keyboard --key NumLock 2>/dev/null)
    case "$nl" in
      0) printf "$(t st_num_on)" ;;
      1) printf "$(t st_num_off)" ;;
      2) printf "$(t st_num_unchanged)" ;;
      *) printf "$(t st_num_unset)" ;;
    esac
  fi
  if [ -e /sys/module/hid_apple/parameters/fnmode ]; then
    printf "$(t st_fn)" "$(cat /sys/module/hid_apple/parameters/fnmode 2>/dev/null || echo '?')"
  fi
  local winfo wiface wdriver
  if winfo=$(detect_wifi); then
    wiface=${winfo%% *}; wdriver=${winfo##* }
    printf "$(t st_wifi)" "$wiface" "${wdriver:-?}"
    printf "$(t st_wifi_ps)" "$(iw dev "$wiface" get power_save 2>/dev/null | awk -F': ' '/Power save/{print $2}')"
    if [[ "$wdriver" == rtw88* || "$wdriver" == rtw_* ]]; then
      printf "$(t st_aspm)" "$(cat /sys/module/rtw88_pci/parameters/disable_aspm 2>/dev/null || echo '?')"
      printf "$(t st_lps)" "$(cat /sys/module/rtw88_core/parameters/disable_lps_deep 2>/dev/null || echo '?')"
    fi
  else
    printf "$(t st_wifi_none)"
  fi
  # Boot / kernel-module health.
  if mountpoint -q /boot; then
    printf "$(t st_boot_mounted)"
  elif boot_in_fstab; then
    printf "$(t st_boot_unmounted)"
  else
    printf "$(t st_boot_onroot)"
  fi
  printf "$(t st_orphans)" "$(orphan_modules | grep -c .)"
}

# ==========================================================
#  main
# ==========================================================
case "${1:-all}" in
  teclado|keyboard|kb)     fix_keyboard "${2:-}" ;;
  numlock|numlk|bloqnum)   fix_numlock "${2:-}" ;;
  fnkeys|fn|fnmode)        fix_fnkeys "${2:-}" ;;
  wifi)                    fix_wifi ;;
  mirrors|mirror|espejos)  fix_mirrors ;;
  preupdate|precheck|precomprobacion)  fix_preupdate ;;
  update|actualizar)       fix_update ;;
  repair-boot|repairboot|kernel|bootfix)  fix_repair_boot ;;
  clean-kernels|cleankernels|obsolete)    fix_clean_kernels ;;
  estado|status)           status ;;
  all|"")                  fix_keyboard; echo; fix_numlock; echo; fix_wifi; echo; status ;;
  -h|--help|help)
    sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    err "$(printf "$(t unknown_opt)" "$1")"
    err "$(t usage)"
    exit 1 ;;
esac
