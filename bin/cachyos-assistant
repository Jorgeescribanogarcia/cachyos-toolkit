# Generic multi-selection install menu.
# $1 = category label ; $2 = names array ; $3 = pkgs array ; $4 = desc base name
# (the description array is picked as "${4}_${UI_LANG^^}").
category_menu() {
  local label="$1"
  local -n _names="$2" _pkgs="$3"
  local -n _desc="${4}_${UI_LANG^^}"
  local total=${#_names[@]}
  while true; do
    header "$(t menu_install_apps) › $label"
    local i
    for i in "${!_names[@]}"; do
      printf '  %s%2d)%s %-26s %s%s%s\n' \
        "$C_B" "$((i+1))" "$C_RESET" "${_names[$i]}" "$C_DIM" "${_desc[$i]}" "$C_RESET"
    done
    printf '\n  %sa)%s %s\n' "$C_B" "$C_RESET" "$(t install_all)"
    printf '  %sL)%s %s\n' "$C_B" "$C_RESET" "$(printf "$(t view_list)" "${#LIST_NAMES[@]}")"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"

    local line; read -rp "$(t cat_prompt)" line
    [ "$line" = "0" ] && return
    [[ "$line" =~ ^[lL]$ ]] && { list_menu; continue; }
    line=${line//,/ }

    # Build the selection (names and packages in parallel, one entry per app).
    local -a sel_names=() sel_pkgs=()
    if [[ "$line" =~ ^[aA]$ ]]; then
      sel_names=("${_names[@]}")
      sel_pkgs=("${_pkgs[@]}")
    else
      local n
      for n in $line; do
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "$total" ]; then
          sel_names+=("${_names[$((n-1))]}")
          sel_pkgs+=("${_pkgs[$((n-1))]}")
        else
          warn "$(printf "$(t ignored_value)" "$n")"
        fi
      done
    fi

    if [ "${#sel_pkgs[@]}" -eq 0 ]; then
      warn "$(t nothing_selected)"; pause; continue
    fi

    # Install now, uninstall, or save to the list to act on together later?
    # Clean screen showing only this info.
    clear 2>/dev/null || true
    printf '%s%s%s\n\n' "$C_B" "$(printf "$(t selected)" "${sel_names[*]}")" "$C_RESET"
    printf '  %s1)%s %s\n'   "$C_B" "$C_RESET" "$(t opt_install_now)"
    printf '  %s2)%s %s\n'   "$C_B" "$C_RESET" "$(t opt_add_list)"
    printf '  %s3)%s %s\n'   "$C_B" "$C_RESET" "$(t opt_uninstall)"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t cancel)"
    local acc; read -rp "$(t what_to_do)" acc
    clear 2>/dev/null || true
    case "$acc" in
      1)
        local -a flat=(); local e
        for e in "${sel_pkgs[@]}"; do flat+=($e); done
        install_packages "${flat[@]}"
        pause ;;
      2)
        local j
        for j in "${!sel_pkgs[@]}"; do
          list_add "${sel_names[$j]}" "${sel_pkgs[$j]}"
        done ;;   # add: repaint the category menu
      3)
        local -a flat=(); local e
        for e in "${sel_pkgs[@]}"; do flat+=($e); done
        uninstall_packages "${flat[@]}"
        pause ;;
      *) : ;;   # cancel: repaint the category menu
    esac
  done
}

dev_individual_menu() {
  while true; do
    header "$(t dev_ind_title)"
    printf '  %s1)%s %s\n'   "$C_B" "$C_RESET" "$(t dev_editors)"
    printf '  %s2)%s %s\n'   "$C_B" "$C_RESET" "$(t dev_languages)"
    printf '  %s3)%s %s\n'   "$C_B" "$C_RESET" "$(t dev_databases)"
    printf '  %s4)%s %s\n'   "$C_B" "$C_RESET" "$(t dev_tools)"
    printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
    local op; read -rp "$(t dev_choose_type)" op
    case "$op" in
      1) category_menu "$(t subcat_editors)"   EDITORS_NAMES EDITORS_PKGS EDITORS_DESC ;;
      2) category_menu "$(t subcat_languages)" LANGS_NAMES   LANGS_PKGS   LANGS_DESC ;;
      3) category_menu "$(t subcat_databases)" DB_NAMES      DB_PKGS      DB_DESC ;;
      4) category_menu "$(t subcat_tools)"     TOOLS_NAMES   TOOLS_PKGS   TOOLS_DESC ;;
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

dev_section() {
  while true; do
    header "$(t dev_title)"
    printf '  %s1)%s %s\n'   "$C_B" "$C_RESET" "$(t dev_packs)"
    printf '  %s2)%s %s\n'   "$C_B" "$C_RESET" "$(t dev_individual)"
    printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
    local op; read -rp "$(t dev_choose_mode)" op
    case "$op" in
      1) category_menu "$(t subcat_packs)" "PACKS_NAMES_${UI_LANG^^}" PACKS_PKGS PACKS_DESC ;;
      2) dev_individual_menu ;;
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

apps_section() {
  while true; do
    header "$(t menu_install_apps)"
    printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t cat_development)"
    printf '  %s2)%s %s\n' "$C_B" "$C_RESET" "$(t cat_games)"
    printf '  %s3)%s %s\n' "$C_B" "$C_RESET" "$(t cat_multimedia)"
    printf '  %s4)%s %s\n' "$C_B" "$C_RESET" "$(t cat_streaming)"
    printf '  %s5)%s %s\n' "$C_B" "$C_RESET" "$(t cat_editing)"
    printf '  %s6)%s %s\n' "$C_B" "$C_RESET" "$(t cat_office)"
    printf '  %s7)%s %s\n' "$C_B" "$C_RESET" "$(t cat_internet)"
    printf '  %s8)%s %s\n' "$C_B" "$C_RESET" "$(t cat_system)"
    printf '\n  %sL)%s %s\n' "$C_B" "$C_RESET" "$(printf "$(t list_menu)" "${#LIST_NAMES[@]}")"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"

    local op; read -rp "$(t choose_category)" op
    case "$op" in
      1) dev_section ;;
      2) category_menu "$(t cat_games)"      GAMES_NAMES  GAMES_PKGS  GAMES_DESC ;;
      3) category_menu "$(t cat_multimedia)" MEDIA_NAMES  MEDIA_PKGS  MEDIA_DESC ;;
      4) category_menu "$(t cat_streaming)"  STREAM_NAMES STREAM_PKGS STREAM_DESC ;;
      5) category_menu "$(t cat_editing)"    EDIT_NAMES   EDIT_PKGS   EDIT_DESC ;;
      6) category_menu "$(t cat_office)"     OFFICE_NAMES OFFICE_PKGS OFFICE_DESC ;;
      7) category_menu "$(t cat_internet)"   NET_NAMES    NET_PKGS    NET_DESC ;;
      8) category_menu "$(t cat_system)"     SYS_NAMES    SYS_PKGS    SYS_DESC ;;
      l|L) list_menu ;;
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

# ==================================================================
#  SECTION: CONFIGURATION (fixes and tweaks)
# ==================================================================
has_cachyos_fix() { [ -n "$CACHYOS_FIX" ] && [ -x "$CACHYOS_FIX" ]; }

# Run cachyos-fix with the chosen UI language.
run_fix() { CACHYOS_LANG="$UI_LANG" "$CACHYOS_FIX" "$@"; }

apply_fix() { # $1 = subcommand ; $2 = description ; $3… = extra args
  local sub="$1" desc="$2"; shift 2
  if ! has_cachyos_fix; then
    err "$(t fix_not_found_path)"
    pause; return 1
  fi
  printf '\n%s%s%s\n' "$C_DIM" "$desc" "$C_RESET"
  if confirm "$(t apply_fix_confirm)"; then
    run_fix "$sub" "$@"
  else
    warn "$(t fix_skipped)"
  fi
  pause
}

# Keyboard layout selector. Prints the chosen code on stdout
# (menus go to stderr so they don't pollute the capture). Empty = cancel.
choose_layout() {
  local -a codes=( es us latam fr de it pt gb br )
  local -a names_en=( "Spanish (es)" "US English (us)" "Latin America (latam)" \
                      "French (fr)" "German (de)" "Italian (it)" "Portuguese (pt)" \
                      "UK English (gb)" "Brazilian Portuguese (br)" )
  local -a names_es=( "Español (es)" "Inglés EE. UU. (us)" "Latinoamérica (latam)" \
                      "Francés (fr)" "Alemán (de)" "Italiano (it)" "Portugués (pt)" \
                      "Inglés RU (gb)" "Portugués Brasil (br)" )
  local -n names="names_${UI_LANG}"
  { printf '\n'
    local i
    for i in "${!codes[@]}"; do
      printf '   %s%2d)%s %s\n' "$C_B" "$((i+1))" "$C_RESET" "${names[$i]}"
    done
    printf '   %s c)%s %s\n\n' "$C_B" "$C_RESET" "$(t layout_other)"
  } >&2
  local sel; read -rp "$(t layout_prompt)" sel
  sel=${sel:-1}
  if [[ "$sel" =~ ^[cC]$ ]]; then
    local custom; read -rp "$(t layout_code_prompt)" custom
    [ -n "$custom" ] && printf '%s' "$custom"
    return
  fi
  if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#codes[@]}" ]; then
    printf '%s' "${codes[$((sel-1))]}"
  fi
}

# Num Lock behavior chooser. Prints the mode (on|off|unchanged) on stdout;
# menu goes to stderr. Empty output = cancel.
choose_numlock() {
  { printf '\n'
    printf '   %s1)%s %s\n'   "$C_B" "$C_RESET" "$(t numlock_opt_on)"
    printf '   %s2)%s %s\n'   "$C_B" "$C_RESET" "$(t numlock_opt_off)"
    printf '   %s3)%s %s\n\n' "$C_B" "$C_RESET" "$(t numlock_opt_unchanged)"
  } >&2
  local sel; read -rp "$(t numlock_choose_prompt)" sel
  sel=${sel:-1}
  case "$sel" in
    1) printf 'on' ;;
    2) printf 'off' ;;
    3) printf 'unchanged' ;;
    *) : ;;   # anything else = cancel
  esac
}

# Fn key behavior chooser. Prints the mode (fkeys|media|auto) on stdout; menu
# goes to stderr. Empty output = cancel.
choose_fnkeys() {
  { printf '\n'
    printf '   %s1)%s %s\n'   "$C_B" "$C_RESET" "$(t fn_opt_fkeys)"
    printf '   %s2)%s %s\n'   "$C_B" "$C_RESET" "$(t fn_opt_media)"
    printf '   %s3)%s %s\n\n' "$C_B" "$C_RESET" "$(t fn_opt_auto)"
  } >&2
  local sel; read -rp "$(t fn_choose_prompt)" sel
  sel=${sel:-1}
  case "$sel" in
    1) printf 'fkeys' ;;
    2) printf 'media' ;;
    3) printf 'auto' ;;
    *) : ;;   # anything else = cancel
  esac
}

config_section() {
  while true; do
    header "$(t cfg_title)"
    printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t cfg_network)"
    printf '  %s2)%s %s\n' "$C_B" "$C_RESET" "$(t cfg_keyboard)"
    printf '  %s3)%s %s\n' "$C_B" "$C_RESET" "$(t cfg_mirrors)"
    printf '  %s4)%s %s\n' "$C_B" "$C_RESET" "$(t cfg_browser)"
    printf '\n  %sa)%s %s\n' "$C_B" "$C_RESET" "$(t cfg_apply_all)"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"

    local op; read -rp "$(t choose_category)" op
    case "$op" in
      1) fix_network_menu ;;
      2) fix_keyboard_menu ;;
      3) fix_mirrors_menu ;;
      4) config_browser_menu ;;
      a|A)
        if has_cachyos_fix; then
          confirm "$(t cfg_apply_all_confirm)" && run_fix all
        else
          err "$(t fix_not_found)"
        fi
        pause ;;
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

fix_network_menu() {
  header "$(t net_title)"
  printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t net_wifi)"
  printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
  local op; read -rp "$(t choose)" op
  case "$op" in
    1) apply_fix wifi "$(t desc_wifi)" ;;
    *) : ;;
  esac
}

fix_keyboard_menu() {
  header "$(t kbd_title)"
  printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t kbd_layout)"
  printf '  %s2)%s %s\n' "$C_B" "$C_RESET" "$(t kbd_numlock)"
  printf '  %s3)%s %s\n' "$C_B" "$C_RESET" "$(t kbd_fnkeys)"
  printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
  local op; read -rp "$(t choose)" op
  case "$op" in
    1)
      local lay; lay=$(choose_layout)
      if [ -z "$lay" ]; then warn "$(t kbd_no_layout)"; pause; return; fi
      apply_fix keyboard "$(printf "$(t desc_keyboard)" "$lay")" "$lay" ;;
    2)
      local mode; mode=$(choose_numlock)
      if [ -z "$mode" ]; then warn "$(t numlock_no_choice)"; pause; return; fi
      apply_fix numlock "$(t "desc_numlock_$mode")" "$mode" ;;
    3)
      local mode; mode=$(choose_fnkeys)
      if [ -z "$mode" ]; then warn "$(t fn_no_choice)"; pause; return; fi
      apply_fix fnkeys "$(t "desc_fn_$mode")" "$mode" ;;
    *) : ;;
  esac
}

fix_mirrors_menu() {
  header "$(t mir_title)"
  printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t mir_refresh)"
  printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
  local op; read -rp "$(t choose)" op
  case "$op" in
    1) apply_fix mirrors "$(t desc_mirrors)" ;;
    *) : ;;
  esac
}

# Detect installed web browsers dynamically: any .desktop entry that registers
# the http(s) URL scheme is a candidate. Prints "desktop-id<TAB>Name" per browser.
detect_browsers() {
  local -a dirs=(
    /usr/share/applications
    "$HOME/.local/share/applications"
    /var/lib/flatpak/exports/share/applications
    "$HOME/.local/share/flatpak/exports/share/applications"
  )
  local -A seen=()
  local d f id name
  for d in "${dirs[@]}"; do
    [ -d "$d" ] || continue
    for f in "$d"/*.desktop; do
      [ -f "$f" ] || continue
      grep -qiE '^MimeType=.*x-scheme-handler/http' "$f" || continue
      grep -qiE '^(Hidden|NoDisplay)=true' "$f" && continue
      id=$(basename "$f")
      [ -n "${seen[$id]:-}" ] && continue
      seen[$id]=1
      name=$(awk -F= '/^Name=/{print $2; exit}' "$f")
      printf '%s\t%s\n' "$id" "${name:-$id}"
    done
  done
}

# Map a browser desktop-id to its friendly Name (falls back to the id).
browser_name() { # $1 = desktop id
  local line
  line=$(detect_browsers | awk -F'\t' -v id="$1" '$1==id{print $2; exit}')
  printf '%s' "${line:-$1}"
}

config_browser_menu() {
  # xdg-settings (xdg-utils) is the portable way to set the default browser.
  if ! command -v xdg-settings >/dev/null 2>&1; then
    header "$(t browser_title)"
    warn "$(t browser_no_xdg)"
    if confirm "$(t browser_install_xdg)"; then
      sudo pacman -S --needed --noconfirm xdg-utils || { err "$(t browser_xdg_fail)"; pause; return; }
    else
      pause; return
    fi
  fi

  local -a ids=() names=()
  local id name
  while IFS=$'\t' read -r id name; do
    [ -n "$id" ] || continue
    ids+=("$id"); names+=("$name")
  done < <(detect_browsers | sort -t$'\t' -k2 -f)

  while true; do
    header "$(t browser_title)"
    local cur; cur=$(xdg-settings get default-web-browser 2>/dev/null)
    if [ -n "$cur" ]; then
      printf '%s%s%s\n\n' "$C_DIM" "$(printf "$(t browser_current)" "$(browser_name "$cur")")" "$C_RESET"
    else
      printf '%s%s%s\n\n' "$C_DIM" "$(t browser_current_none)" "$C_RESET"
    fi

    if [ "${#ids[@]}" -eq 0 ]; then
      warn "$(t browser_none_found)"; pause; return
    fi
    local i
    for i in "${!ids[@]}"; do
      printf '  %s%2d)%s %-24s %s%s%s\n' \
        "$C_B" "$((i+1))" "$C_RESET" "${names[$i]}" "$C_DIM" "${ids[$i]}" "$C_RESET"
    done
    printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"

    local op; read -rp "$(t browser_choose)" op
    case "$op" in
      0|"") return ;;
      *)
        if [[ "$op" =~ ^[0-9]+$ ]] && [ "$op" -ge 1 ] && [ "$op" -le "${#ids[@]}" ]; then
          local sel="${ids[$((op-1))]}"
          if xdg-settings set default-web-browser "$sel" 2>/dev/null; then
            ok "$(printf "$(t browser_set_ok)" "${names[$((op-1))]}")"
          else
            err "$(t browser_set_fail)"
          fi
          pause
        else
          warn "$(t invalid_option)"; pause
        fi ;;
    esac
  done
}

# ==================================================================
#  SECTION: STATUS
# ==================================================================
status_section() {
  header "$(t status_title)"
  if has_cachyos_fix; then
    run_fix status
  else
    warn "$(t fix_not_found_basic)"
    printf '   WiFi power_save : %s\n' "$(iw dev wlan0 get power_save 2>/dev/null | awk -F': ' '/Power save/{print $2}')"
  fi
  pause
}

# ==================================================================
#  SECTION: SERVICES (systemd service manager)
# ==================================================================
# Generic manager: turn services on/off and set autostart at boot. The list is
# built DYNAMICALLY from systemd (no hardcoded services), with filters so it
# stays usable: apps / running / autostart / failed / all / system.
#
# It spans two managers: the SYSTEM systemd (actions need sudo) and the USER
# session (systemctl --user, no sudo). The 'apps' filter (default) lists the
# applications launched this session — Discord, Steam, Brave… — which run as
# 'app-*' USER units and are therefore invisible to the system manager. Each
# entry remembers its scope so actions dispatch to the right manager.
#
# Two failure modes we hit with XAMPP and guard against for EVERY service:
#
#   1) The status lied. 'systemctl is-active' only reflects reality for services
#      controlled THROUGH systemd. Apps with their own control script/GUI (XAMPP:
#      /opt/lampp) can run outside systemd, so is-active shows "stopped" while
#      they are clearly up. Such apps must NOT go through the generic path:
#      handle them specially (real state by process, on/off via their own tool).
#      See the XAMPP block below as the template for any future dual-control app.
#
#   2) Enable/disable failed cryptically. A 'static' unit (no [Install]) cannot
#      be enabled; a 'masked' one cannot start/enable. The generic actions
#      (svc_start_generic / svc_enable_generic / svc_disable_generic) detect
#      these and explain (offering to unmask) instead of erroring out.
XAMPP_CTL="/opt/lampp/lampp"

# A filter targets either the SYSTEM systemd (sudo) or the USER session
# (systemctl --user, no sudo). The 'apps' filter shows the applications you
# launched this session (Discord, Steam, Brave…), which run as 'app-*' user
# units — they are not system services, which is why they never showed before.
svc_filter_scope() { # $1 = filter → 'user' or 'system'
  case "$1" in apps|user) printf 'user' ;; *) printf 'system' ;; esac
}

# True if the unit is known to the given manager.
svc_known() { # $1 = scope ; $2 = unit
  if [ "$1" = user ]; then systemctl --user cat -- "$2" >/dev/null 2>&1
  else                     systemctl        cat -- "$2" >/dev/null 2>&1; fi
}

# --- Dynamic enumeration from systemd (no hardcoded service list) ---
# List unit names for a filter, one per line, sorted alphabetically
# (case-insensitive, so e.g. NetworkManager sorts with the lowercase names).
# 'all' and 'system' enumerate every installed service; the system/user split
# is applied later by svc_is_system when the list is built.
svc_list_units() { # $1 = apps | running | enabled | failed | all | system
  case "$1" in
    apps)       systemctl --user list-units --state=running --no-legend --plain 2>/dev/null | awk '{print $1}' | grep -E '^app-' | sort -f ;;
    running)    systemctl list-units --type=service --state=running --no-legend --plain 2>/dev/null | awk '{print $1}' | sort -f ;;
    failed)     systemctl list-units --type=service --state=failed  --no-legend --plain 2>/dev/null | awk '{print $1}' | sort -f ;;
    enabled)    systemctl list-unit-files --type=service --state=enabled --no-legend 2>/dev/null | awk '{print $1}' | sort -f ;;
    all|system) systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '{print $1}' | sort -uf ;;
  esac
}

# Heuristic: is this a system/OS-plumbing service? These are hidden from the
# normal filters and shown only under the 'system' filter. It covers systemd's
# own units, template/instance units (name has '@'), and well-known low-level
# daemons. Not perfect (there is no reliable "shipped with the OS" flag), so it
# is deliberately easy to tune by editing the patterns below.
svc_is_system() { # $1 = unit (with or without .service)
  local u="${1%.service}"
  case "$u" in
    systemd-*|systemd)              return 0 ;;
    *@*)                            return 0 ;;   # template/instance units
    dbus|dbus-broker|dbus-org.*)    return 0 ;;
    polkit|rtkit-daemon|accounts-daemon)                 return 0 ;;
    udisks2|upower|power-profiles-daemon|switcheroo-control|colord|geoclue) return 0 ;;
    ModemManager|wpa_supplicant|iwd|avahi-daemon)        return 0 ;;
    NetworkManager-wait-online|NetworkManager-dispatcher) return 0 ;;
    plasmalogin|sddm|gdm|lightdm|greetd|ly)              return 0 ;;
    ananicy-cpp|dmemcg-*|thermald|irqbalance|haveged|rngd|smartd) return 0 ;;
    plymouth-*|dracut-*|initrd-*|emergency|rescue|kmod-static-nodes|ldconfig) return 0 ;;
    fstrim|logrotate|man-db|updatedb|shadow)             return 0 ;;
    reflector|archlinux-keyring-wkd-sync|cachyos-*)      return 0 ;;
    *)                              return 1 ;;
  esac
}

# Cycle to the next filter (apps first, so launched apps show by default).
svc_next_filter() { # $1 = current filter
  case "$1" in
    apps)    printf 'running' ;;
    running) printf 'enabled' ;;
    enabled) printf 'failed' ;;
    failed)  printf 'all' ;;
    all)     printf 'system' ;;
    *)       printf 'apps' ;;
  esac
}

# Localized name of a filter.
svc_filter_name() { # $1 = filter
  case "$1" in
    apps)    t svc_filter_apps ;;
    running) t svc_filter_running ;;
    enabled) t svc_filter_enabled ;;
    failed)  t svc_filter_failed ;;
    all)     t svc_filter_all ;;
    system)  t svc_filter_system ;;
  esac
}

# Bulk-load every unit's active/enabled state (and description) for a manager in
# two calls, so painting a long list needs no per-unit systemctl queries.
declare -A SVC_ACTIVE SVC_ENABLED SVC_DESC
svc_load_states() { # $1 = scope (system|user)
  SVC_ACTIVE=(); SVC_ENABLED=(); SVC_DESC=()
  local -a ctl=(systemctl); [ "$1" = user ] && ctl=(systemctl --user)
  local unit load active sub desc state preset
  while read -r unit load active sub desc; do
    [ -n "$unit" ] || continue
    SVC_ACTIVE["$unit"]="$active"; SVC_DESC["$unit"]="$desc"
  done < <("${ctl[@]}" list-units --all --no-legend --plain 2>/dev/null)
  while read -r unit state preset; do
    [ -n "$unit" ] && SVC_ENABLED["$unit"]="$state"
  done < <("${ctl[@]}" list-unit-files --no-legend 2>/dev/null)
}

xampp_present() { [ -x "$XAMPP_CTL" ]; }

# XAMPP is special: it can be started by its own script or GUI, outside systemd,
# so systemd's view is unreliable. Read the real running state from the daemons.
xampp_running() {
  pgrep -f '/opt/lampp/bin/httpd'   >/dev/null 2>&1 && return 0
  pgrep -f '/opt/lampp/sbin/mysqld' >/dev/null 2>&1 && return 0
  return 1
}

# Whether the active xampp unit can be enabled for boot (has an [Install]
# section). The unit XAMPP ships is 'static' (no [Install]), so it cannot.
xampp_can_autostart() {
  case "$(systemctl is-enabled xampp 2>/dev/null)" in
    enabled|disabled) return 0 ;;
    *)                return 1 ;;
  esac
}

# Colored "running · autostart" badges for XAMPP (real state, not systemd's).
xampp_badges() {
  local r_txt e_txt
  if xampp_running; then r_txt="${C_GREEN}$(t svc_running)${C_RESET}"
  else                   r_txt="${C_DIM}$(t svc_stopped)${C_RESET}"; fi
  if [ "$(systemctl is-enabled xampp 2>/dev/null)" = enabled ]; then
    e_txt="${C_GREEN}$(t svc_enabled)${C_RESET}"
  else
    e_txt="${C_DIM}$(t svc_disabled)${C_RESET}"   # disabled/static → won't autostart
  fi
  printf '%s · %s' "$r_txt" "$e_txt"
}

# Render colored "state · autostart" badges from raw states.
_svc_render_badges() { # $1 = active-state ; $2 = enabled-state
  local act="$1" ena="$2" a_txt e_txt
  case "$act" in
    active)                  a_txt="${C_GREEN}$(t svc_running)${C_RESET}" ;;
    failed)                  a_txt="${C_RED}$(t svc_failed)${C_RESET}" ;;
    activating|deactivating) a_txt="${C_YELLOW}${act}${C_RESET}" ;;
    *)                       a_txt="${C_DIM}$(t svc_stopped)${C_RESET}" ;;
  esac
  case "$ena" in
    enabled|enabled-runtime)   e_txt="${C_GREEN}$(t svc_enabled)${C_RESET}" ;;
    disabled)                  e_txt="${C_DIM}$(t svc_disabled)${C_RESET}" ;;
    masked)                    e_txt="${C_RED}$(t svc_masked)${C_RESET}" ;;
    static|indirect|generated) e_txt="${C_DIM}${ena}${C_RESET}" ;;
    *)                         e_txt="${C_DIM}—${C_RESET}" ;;
  esac
  printf '%s · %s' "$a_txt" "$e_txt"
}

# Live badges for a single unit (used in the action menu, always fresh).
svc_badges() { # $1 = scope ; $2 = unit
  local -a ctl=(systemctl); [ "$1" = user ] && ctl=(systemctl --user)
  _svc_render_badges \
    "$("${ctl[@]}" is-active  -- "$2" 2>/dev/null)" \
    "$("${ctl[@]}" is-enabled -- "$2" 2>/dev/null)"
}

# Cached badges from the bulk maps (used to paint the list without per-unit calls).
svc_badges_row() { _svc_render_badges "${SVC_ACTIVE[$1]:-inactive}" "${SVC_ENABLED[$1]:-}"; }

# Friendly label for a user/app unit. Prefer systemd's Description; if it is
# missing (some app scopes have none, so systemd echoes the unit id), derive a
# readable name from the unit id: app-org.kde.konsole-2123.scope -> konsole.
svc_app_label() { # $1 = unit ; $2 = raw description
  local u="$1" d="$2"
  if [ -n "$d" ] && [ "$d" != "$u" ]; then printf '%s' "$d"; return; fi
  local n="${u%.scope}"; n="${n%.service}"; n="${n#app-}"
  n="${n%@*}"        # drop @<hash>
  n="${n%-[0-9]*}"   # drop trailing -<pid>
  n="${n##*.}"       # last segment of a reverse-DNS id (org.kde.konsole -> konsole)
  printf '%s' "$n"
}

# Create a systemd unit that wraps the XAMPP control script, so XAMPP can be
# managed like any other service (start/stop/enable). Type=oneshot with
# RemainAfterExit fits a script that starts several daemons and then exits.
xampp_setup_unit() {
  local unit="/etc/systemd/system/xampp.service"
  local content="[Unit]
Description=XAMPP (Apache + MariaDB + PHP)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$XAMPP_CTL start
ExecStop=$XAMPP_CTL stop

[Install]
WantedBy=multi-user.target"
  if printf '%s\n' "$content" | sudo tee "$unit" >/dev/null; then
    sudo systemctl daemon-reload
    ok "$(t svc_xampp_created)"
    return 0
  fi
  err "$(t svc_xampp_create_fail)"
  return 1
}

# Raw is-enabled of a unit in its manager.
svc_isenabled() { # $1 = scope ; $2 = unit
  if [ "$1" = user ]; then systemctl --user is-enabled -- "$2" 2>/dev/null
  else                     systemctl        is-enabled -- "$2" 2>/dev/null; fi
}

# Run a systemctl action and report the result. System actions use sudo; user
# actions (apps/user session) do not.
svc_run() { # $1 = scope ; $2 = unit ; $3 = action
  local rc=0
  if [ "$1" = user ]; then systemctl --user "$3" -- "$2" || rc=1
  else                     sudo systemctl    "$3" -- "$2" || rc=1; fi
  [ "$rc" -eq 0 ] && ok "$(t svc_done)" || err "$(t svc_action_fail)"
  pause
}

# --- Safety net: never fail cryptically on masked/static/transient units ---
# A masked unit cannot start/enable; a static one (no [Install]) or a transient
# one (an app scope) cannot be enabled/disabled. Detect these and explain.

# Offer to unmask a masked unit, then run the action; returns 1 if declined.
svc_unmask_then() { # $1 = scope ; $2 = unit ; $3 = action
  warn "$(t svc_is_masked)"
  if confirm "$(t svc_unmask_ask)"; then
    if [ "$1" = user ]; then systemctl --user unmask -- "$2"; else sudo systemctl unmask -- "$2"; fi \
      && svc_run "$1" "$2" "$3"
  else
    pause; return 1
  fi
}

svc_start_generic() { # $1 = scope ; $2 = unit
  if [ "$(svc_isenabled "$1" "$2")" = masked ]; then
    svc_unmask_then "$1" "$2" start; return
  fi
  svc_run "$1" "$2" start
}

svc_enable_generic() { # $1 = scope ; $2 = unit
  case "$(svc_isenabled "$1" "$2")" in
    masked)                                    svc_unmask_then "$1" "$2" enable ;;
    static|indirect|generated|alias|transient) warn "$(t svc_static_info)"; pause ;;
    *)                                         svc_run "$1" "$2" enable ;;
  esac
}

svc_disable_generic() { # $1 = scope ; $2 = unit
  case "$(svc_isenabled "$1" "$2")" in
    masked)                                    warn "$(t svc_is_masked)"; pause ;;
    static|indirect|generated|alias|transient) warn "$(t svc_static_info)"; pause ;;
    *)                                         svc_run "$1" "$2" disable ;;
  esac
}

# Action menu for a single unit (system service or user/app unit).
service_actions() { # $1 = scope ; $2 = unit ; $3 = label
  local scope="$1" unit="$2" label="$3"
  while true; do
    header "$(t svc_title)"
    printf '%s%s%s\n' "$C_B" "$(printf "$(t svc_actions_title)" "$label")" "$C_RESET"
    printf '   %s\n\n' "$(svc_badges "$scope" "$unit")"
    printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t svc_start)"
    printf '  %s2)%s %s\n' "$C_B" "$C_RESET" "$(t svc_stop)"
    printf '  %s3)%s %s\n' "$C_B" "$C_RESET" "$(t svc_restart)"
    printf '  %s4)%s %s\n' "$C_B" "$C_RESET" "$(t svc_enable)"
    printf '  %s5)%s %s\n' "$C_B" "$C_RESET" "$(t svc_disable)"
    printf '  %s6)%s %s\n' "$C_B" "$C_RESET" "$(t svc_view_status)"
    printf '\n  %sr)%s %s\n' "$C_B" "$C_RESET" "$(t svc_refresh)"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
    local op; read -rp "$(t choose)" op
    case "$op" in
      1) svc_start_generic "$scope" "$unit" ;;
      2) svc_run "$scope" "$unit" stop ;;
      3) svc_run "$scope" "$unit" restart ;;
      4) svc_enable_generic "$scope" "$unit" ;;
      5) svc_disable_generic "$scope" "$unit" ;;
      6) if [ "$scope" = user ]; then systemctl --user status --no-pager -- "$unit"
         else                         systemctl        status --no-pager -- "$unit"; fi
         pause ;;
      r|R) continue ;;   # re-loop: re-reads the badge
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

# Run a XAMPP control action through its own script (start/stop/restart/status).
svc_run_xampp() { # $1 = lampp action
  if sudo "$XAMPP_CTL" "$1"; then
    ok "$(t svc_done)"
  else
    err "$(t svc_action_fail)"
  fi
  pause
}

# Turn XAMPP autostart on. The shipped unit is 'static' (no [Install]); create
# our own unit (with [Install]) if needed so 'systemctl enable' works.
xampp_enable() {
  if ! xampp_can_autostart; then
    xampp_setup_unit || { pause; return; }
  fi
  svc_run system xampp enable
}

# Action menu for XAMPP: on/off/restart via its script, autostart via systemd.
xampp_actions() { # $1 = label
  local label="$1"
  while true; do
    header "$(t svc_title)"
    printf '%s%s%s\n' "$C_B" "$(printf "$(t svc_actions_title)" "$label")" "$C_RESET"
    printf '   %s\n\n' "$(xampp_badges)"
    printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t svc_start)"
    printf '  %s2)%s %s\n' "$C_B" "$C_RESET" "$(t svc_stop)"
    printf '  %s3)%s %s\n' "$C_B" "$C_RESET" "$(t svc_restart)"
    printf '  %s4)%s %s\n' "$C_B" "$C_RESET" "$(t svc_enable)"
    printf '  %s5)%s %s\n' "$C_B" "$C_RESET" "$(t svc_disable)"
    printf '  %s6)%s %s\n' "$C_B" "$C_RESET" "$(t svc_view_status)"
    printf '\n  %sr)%s %s\n' "$C_B" "$C_RESET" "$(t svc_refresh)"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
    local op; read -rp "$(t choose)" op
    case "$op" in
      1) svc_run_xampp start ;;
      2) svc_run_xampp stop ;;
      3) svc_run_xampp restart ;;
      4) xampp_enable ;;
      5) if xampp_can_autostart; then svc_run system xampp disable
         else warn "$(t svc_autostart_na)"; pause; fi ;;
      6) sudo "$XAMPP_CTL" status; pause ;;
      r|R) continue ;;   # re-loop: re-reads the badge
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

services_section() {
  local filter="apps"   # default: show the apps launched this session
  while true; do
    header "$(t svc_title)"
    printf '%s%s%s\n\n' "$C_DIM" \
      "$(printf "$(t svc_filter_label)" "$(svc_filter_name "$filter")")" "$C_RESET"

    local scope; scope="$(svc_filter_scope "$filter")"
    svc_load_states "$scope"   # one bulk read of this manager's states, for fast painting

    # Build the visible list dynamically. For system-scope filters, XAMPP goes
    # first (special dual-control entry) and OS/plumbing services are hidden
    # unless the filter is 'system'. For the 'apps'/user scope, entries are
    # shown with their friendly description (Discord, Brave…).
    local -a units=() labels=()
    if [ "$scope" = system ] && [ "$filter" != system ] && xampp_present; then
      units+=("xampp"); labels+=("XAMPP (Apache + MariaDB + PHP)")
    fi
    local u
    while IFS= read -r u; do
      [ -n "$u" ] || continue
      if [ "$scope" = system ]; then
        [ "$u" = "xampp.service" ] && continue   # shown as the special entry above
        if [ "$filter" = system ]; then
          svc_is_system "$u" || continue         # system filter: only system units
        else
          svc_is_system "$u" && continue         # other filters: hide system units
        fi
        units+=("$u"); labels+=("${u%.service}")
      else
        units+=("$u"); labels+=("$(svc_app_label "$u" "${SVC_DESC[$u]:-}")")
      fi
    done < <(svc_list_units "$filter")

    if [ "${#units[@]}" -eq 0 ]; then
      warn "$(t svc_none_in_filter)"
    else
      local i badge
      for i in "${!units[@]}"; do
        if [ "${units[$i]}" = xampp ]; then
          badge="$(xampp_badges)"
        else
          badge="$(svc_badges_row "${units[$i]}")"
        fi
        printf '  %s%3d)%s %-34s %s\n' "$C_B" "$((i+1))" "$C_RESET" "${labels[$i]}" "$badge"
      done
    fi

    printf '\n  %sf)%s %s\n' "$C_B" "$C_RESET" "$(t svc_change_filter)"
    printf '  %sr)%s %s\n'   "$C_B" "$C_RESET" "$(t svc_refresh)"
    printf '  %sn)%s %s\n'   "$C_B" "$C_RESET" "$(t svc_other_unit)"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"

    local op; read -rp "$(t svc_choose)" op
    case "$op" in
      0|"") return ;;
      f|F) filter="$(svc_next_filter "$filter")" ;;
      r|R) : ;;   # re-loop: reloads states and repaints
      n|N)
        local un; read -rp "$(t svc_unit_prompt)" un
        [ -z "$un" ] && continue
        if svc_known "$scope" "$un"; then
          service_actions "$scope" "$un" "${un%.service}"
        else
          warn "$(t svc_not_available)"; pause
        fi ;;
      *)
        if [[ "$op" =~ ^[0-9]+$ ]] && [ "$op" -ge 1 ] && [ "$op" -le "${#units[@]}" ]; then
          local sel_unit="${units[$((op-1))]}" sel_label="${labels[$((op-1))]}"
          if [ "$sel_unit" = xampp ]; then
            xampp_actions "$sel_label"
          else
            service_actions "$scope" "$sel_unit" "$sel_label"
          fi
        else
          warn "$(t invalid_option)"; pause
        fi ;;
    esac
  done
}

# ==================================================================
#  LANGUAGE
# ==================================================================
# Startup / on-demand language chooser. Preselects the current UI_LANG.
choose_language() {
  header "$(t lang_title)"
  local def_num def_lbl
  if [ "$UI_LANG" = es ]; then def_num=2; def_lbl="Español"; else def_num=1; def_lbl="English"; fi
  printf '  %s1)%s English\n'  "$C_B" "$C_RESET"
  printf '  %s2)%s Español\n\n' "$C_B" "$C_RESET"
  local sel; read -rp "$(printf 'Language / Idioma [%s]: ' "$def_lbl")" sel
  sel=${sel:-$def_num}
  case "$sel" in
    1|en|EN|english|English|inglés|ingles) UI_LANG=en ;;
    2|es|ES|español|espanol|Español|spanish|Spanish) UI_LANG=es ;;
    *) : ;;  # keep current
  esac
  save_lang
  ok "$(t lang_saved)"
  pause
}

# ==================================================================
#  MAIN MENU
# ==================================================================
main_menu() {
  while true; do
    header "$(printf "$(t main_pkgmgr)" "$(detect_helper)")"
    printf '  %s1)%s %s\n' "$C_B" "$C_RESET" "$(t main_install)"
    printf '  %s2)%s %s\n' "$C_B" "$C_RESET" "$(t main_config)"
    printf '  %s3)%s %s\n' "$C_B" "$C_RESET" "$(t main_services)"
    printf '  %s4)%s %s\n' "$C_B" "$C_RESET" "$(t main_status)"
    printf '  %s5)%s %s\n' "$C_B" "$C_RESET" "$(t main_language)"
    printf '\n  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t exit)"

    local op; read -rp "$(t main_choose)" op
    case "$op" in
      1) apps_section ;;
      2) config_section ;;
      3) services_section ;;
      4) status_section ;;
      5) choose_language ;;
      0|q|Q) header "$(t goodbye)"; exit 0 ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

# ---------------------------- Startup -----------------------------
load_lang
# First run (no env override, no saved choice): ask once and remember it.
[ "$LANG_SOURCE" = default ] && choose_language
main_menu
