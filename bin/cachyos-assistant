# Translate a message key into the current language (falls back to EN, then key).
t() {
  local key="$1"
  local -n _cat="MSG_${UI_LANG^^}"
  local v="${_cat[$key]:-}"
  [ -n "$v" ] || v="${MSG_EN[$key]:-$key}"
  printf '%s' "$v"
}

# ---------------------------- Helpers -----------------------------
header() {
  clear 2>/dev/null || true
  printf '%s\n' "${C_CYAN}╔══════════════════════════════════════════════╗${C_RESET}"
  printf '%s%-46s%s\n' "${C_CYAN}║  ${C_B}" "$(t app_title)" "${C_RESET}${C_CYAN}║${C_RESET}"
  printf '%s%-46s%s\n' "${C_CYAN}║  ${C_DIM}" "${1:-}" "${C_RESET}${C_CYAN}║${C_RESET}"
  printf '%s\n\n' "${C_CYAN}╚══════════════════════════════════════════════╝${C_RESET}"
}
ok()   { printf '   %s✔%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '   %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
err()  { printf '   %s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
pause(){ printf '\n%s%s%s' "$C_DIM" "$(t press_enter)" "$C_RESET"; read -r _; }

confirm() { # $1 = question ; returns 0 on yes
  local r
  read -rp "$(printf '%s%s [%s]: %s' "$C_B" "$1" "$(t yn_hint)" "$C_RESET")" r
  [[ "$r" =~ ^[sSyY]$ ]]
}

# ---------------- Single-choice menu (arrow / number nav) ---------
# Renders a menu and stores the chosen key in MENU_RESULT. Respects NAV_MODE:
#   arrows  → ↑/↓ (or k/j) move, Enter picks the highlighted row, pressing a
#             row's key selects it directly, q/Esc/← return the back key.
#   numbers → classic: print the list and read a typed key/line.
# Args: <title> <keys_array_name> <labels_array_name> [back_key]. An optional
# dim info line can be shown by setting MENU_INFO before the call.
MENU_RESULT=""
MENU_INFO=""
menu_pick() {
  local title="$1"; local -n _pk="$2" _pl="$3"; local back="${4:-0}"
  local n="${#_pk[@]}" i

  if [ "$NAV_MODE" = numbers ]; then
    header "$title"
    [ -n "$MENU_INFO" ] && printf '%s\n\n' "$MENU_INFO"
    for i in "${!_pk[@]}"; do
      printf '  %s%s)%s %s\n' "$C_B" "${_pk[$i]}" "$C_RESET" "${_pl[$i]}"
    done
    local op; read -rp "$(printf '\n%s' "$(t choose)")" op
    MENU_RESULT="${op:-$back}"
    return
  fi

  # arrows mode
  local sel=0 k rest
  while true; do
    header "$title"
    [ -n "$MENU_INFO" ] && printf '%s\n\n' "$MENU_INFO"
    for i in "${!_pk[@]}"; do
      if [ "$i" -eq "$sel" ]; then
        printf '  %s▸ %s)%s %s\n' "$C_CYAN$C_B" "${_pk[$i]}" "$C_RESET" "${_pl[$i]}"
      else
        printf '    %s%s)%s %s\n' "$C_DIM" "${_pk[$i]}" "$C_RESET" "${_pl[$i]}"
      fi
    done
    printf '\n%s%s%s' "$C_DIM" "$(t nav_hint)" "$C_RESET"
    IFS= read -rsn1 k
    case "$k" in
      '')  MENU_RESULT="${_pk[$sel]}"; return ;;                  # Enter
      $'\x1b')
        read -rsn2 -t 0.05 rest 2>/dev/null
        case "$rest" in
          '[A') sel=$(( (sel-1+n)%n )) ;;                         # up
          '[B') sel=$(( (sel+1)%n )) ;;                           # down
          '[D'|'') MENU_RESULT="$back"; return ;;                 # left / bare Esc
        esac ;;
      k|K) sel=$(( (sel-1+n)%n )) ;;
      j|J) sel=$(( (sel+1)%n )) ;;
      q|Q) MENU_RESULT="$back"; return ;;
      *)
        for i in "${!_pk[@]}"; do
          [ "${_pk[$i],,}" = "${k,,}" ] && { MENU_RESULT="${_pk[$i]}"; return; }
        done ;;
    esac
  done
}

# ---------------- Multi-choice menu (checkboxes) ------------------
# Lets you tick several items. Sets MULTI_ACTION and MULTI_SEL (0-based indices):
#   ok     → MULTI_SEL has ≥1 selected item
#   empty  → Enter pressed with nothing selected (caller usually warns + stays)
#   list   → the user asked to open the installation list ('L')
#   cancel → the user backed out (q/Esc/←/0 or empty line)
# NAV_MODE: arrows → ↑/↓ move, Space (or a digit) toggles, 'a' toggles all,
# Enter confirms; numbers → classic "type 1 3 5", 'a'=all, 'L'=list, 0=back.
declare -a MULTI_SEL=()
MULTI_ACTION=""
menu_pick_multi() {
  local title="$1"; local -n _ml="$2"
  local n="${#_ml[@]}" i
  MULTI_SEL=(); MULTI_ACTION=""

  if [ "$NAV_MODE" = numbers ]; then
    header "$title"
    for i in "${!_ml[@]}"; do printf '  %s%2d)%s %s\n' "$C_B" "$((i+1))" "$C_RESET" "${_ml[$i]}"; done
    printf '\n  %sa)%s %s\n' "$C_B" "$C_RESET" "$(t install_all)"
    printf '  %sL)%s %s\n'   "$C_B" "$C_RESET" "$(printf "$(t view_list)" "${#LIST_NAMES[@]}")"
    printf '  %s0)%s %s\n\n' "$C_B" "$C_RESET" "$(t back)"
    local line; read -rp "$(t cat_prompt)" line
    case "$line" in
      0|"") MULTI_ACTION=cancel; return ;;
      [lL]) MULTI_ACTION=list; return ;;
      [aA]) for i in "${!_ml[@]}"; do MULTI_SEL+=("$i"); done; MULTI_ACTION=ok; return ;;
    esac
    line=${line//,/ }
    local nn
    for nn in $line; do
      [[ "$nn" =~ ^[0-9]+$ ]] && [ "$nn" -ge 1 ] && [ "$nn" -le "$n" ] && MULTI_SEL+=("$((nn-1))")
    done
    [ "${#MULTI_SEL[@]}" -gt 0 ] && MULTI_ACTION=ok || MULTI_ACTION=empty
    return
  fi

  # arrows mode: checkboxes
  local -a chk=(); for i in $(seq 0 $((n-1))); do chk[$i]=0; done
  local sel=0 k rest box d allon
  while true; do
    header "$title"
    printf '%s%s%s\n\n' "$C_DIM" "$(t multi_keys)" "$C_RESET"
    for i in "${!_ml[@]}"; do
      if [ "${chk[$i]}" = 1 ]; then box="[$C_GREEN✔$C_RESET]"; else box="[ ]"; fi
      if [ "$i" -eq "$sel" ]; then printf '  %s▸%s %s %s\n' "$C_CYAN$C_B" "$C_RESET" "$box" "${_ml[$i]}"
      else                          printf '    %s %s\n' "$box" "${_ml[$i]}"; fi
    done
    IFS= read -rsn1 k
    case "$k" in
      ' ') chk[$sel]=$(( 1 - chk[$sel] )) ;;
      '')  for i in "${!chk[@]}"; do [ "${chk[$i]}" = 1 ] && MULTI_SEL+=("$i"); done
           [ "${#MULTI_SEL[@]}" -gt 0 ] && MULTI_ACTION=ok || MULTI_ACTION=empty; return ;;
      $'\x1b') read -rsn2 -t 0.05 rest 2>/dev/null
        case "$rest" in
          '[A') sel=$(( (sel-1+n)%n )) ;;
          '[B') sel=$(( (sel+1)%n )) ;;
          '[D'|'') MULTI_ACTION=cancel; return ;;
        esac ;;
      k|K) sel=$(( (sel-1+n)%n )) ;;
      j|J) sel=$(( (sel+1)%n )) ;;
      a|A) allon=1; for i in "${!chk[@]}"; do [ "${chk[$i]}" = 0 ] && allon=0; done
           for i in "${!chk[@]}"; do chk[$i]=$(( 1 - allon )); done ;;
      l|L) MULTI_ACTION=list; return ;;
      q|Q) MULTI_ACTION=cancel; return ;;
      [0-9]) d=$((10#$k))
             if [ "$d" -eq 0 ]; then MULTI_ACTION=cancel; return
             elif [ "$d" -ge 1 ] && [ "$d" -le "$n" ]; then sel=$((d-1)); chk[$sel]=$(( 1 - chk[$sel] )); fi ;;
    esac
  done
}

# --------------------------- Guards -------------------------------
if [ "$(id -u)" -eq 0 ]; then
  load_lang
  err "$(t err_root)"
  exit 1
fi

# Locate 'cachyos-fix': first next to this script, otherwise in PATH.
SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CACHYOS_FIX="$SCRIPT_DIR/cachyos-fix"
[ -x "$CACHYOS_FIX" ] || CACHYOS_FIX=$(command -v cachyos-fix 2>/dev/null || true)

# Detect the package manager / AUR helper.
detect_helper() {
  if   command -v paru >/dev/null 2>&1; then echo paru
  elif command -v yay  >/dev/null 2>&1; then echo yay
  else echo pacman; fi
}

# Ensure the AUR build environment ('base-devel' + 'git').
# AUR packages (including '-bin' ones) build with makepkg, which needs the
# 'base-devel' group (fakeroot, make, gcc…) and 'git'. On a fresh system they
# may be missing and the install fails (e.g. visual-studio-code-bin).
# Returns 0 if everything is ready; 1 if it could not install them.
ensure_base_devel() {
  local -a missing=()
  command -v git      >/dev/null 2>&1 || missing+=("git")
  command -v fakeroot >/dev/null 2>&1 || missing+=("base-devel")
  command -v make     >/dev/null 2>&1 || missing+=("base-devel")
  command -v gcc      >/dev/null 2>&1 || missing+=("base-devel")

  # Deduplicate (base-devel may appear several times).
  local -a deps=(); local d
  for d in "${missing[@]}"; do
    [[ " ${deps[*]} " == *" $d "* ]] || deps+=("$d")
  done
  [ "${#deps[@]}" -eq 0 ] && return 0

  warn "$(printf "$(t aur_missing_deps)" "${deps[*]}")"
  printf '   %s%s%s\n\n' "$C_DIM" "$(t aur_installing_deps)" "$C_RESET"
  if sudo pacman -S --needed --noconfirm -- "${deps[@]}"; then
    ok "$(t aur_deps_ok)"
    return 0
  fi
  err "$(printf "$(t aur_deps_fail)" "${deps[*]}")"
  return 1
}

# Install 'paru' when there is no AUR helper.
# On CachyOS 'paru' is in the official repos, so pacman suffices; otherwise it
# is compiled from AUR (git clone + makepkg). Returns 0 if it ends up installed.
install_paru() {
  warn "$(t paru_missing)"
  if ! confirm "$(t paru_ask)"; then
    warn "$(t paru_no_helper)"
    return 1
  fi

  # 1) Fast path: paru is packaged in the CachyOS repos.
  printf '\n%s%s%s\n' "$C_DIM" "$(t paru_searching)" "$C_RESET"
  if sudo pacman -S --needed --noconfirm paru; then
    ok "$(t paru_from_repo)"
    return 0
  fi

  # 2) Fallback: build paru from AUR.
  warn "$(t paru_compiling)"
  ensure_base_devel || return 1

  local tmp; tmp=$(mktemp -d) || { err "$(t tmpdir_fail)"; return 1; }
  local rc=0
  if git clone --depth 1 https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin" \
     && ( cd "$tmp/paru-bin" && makepkg -si --noconfirm ); then
    ok "$(t paru_from_aur)"
  else
    err "$(t paru_fail)"
    rc=1
  fi
  rm -rf "$tmp"
  return "$rc"
}

# Install a list of packages.
install_packages() {
  local helper; helper=$(detect_helper)

  # If there is no AUR helper, offer to install one first.
  if [ "$helper" = pacman ]; then
    if install_paru; then
      helper=$(detect_helper)   # re-detect: should be paru now
    fi
  fi

  printf '\n%s%s%s\n\n' "$C_B" "$(printf "$(t install_with)" "$helper" "$*")" "$C_RESET"
  if ! confirm "$(t confirm_install)"; then
    warn "$(t install_cancelled)"; return 1
  fi
  if [ "$helper" = pacman ]; then
    warn "$(t pacman_only)"
    sudo pacman -S --needed -- "$@"
  else
    # Prepare the AUR build environment before installing.
    if ! ensure_base_devel; then
      err "$(t aur_env_cancel)"
      return 1
    fi
    # --skipreview avoids the «Edit now?» prompt and the PKGBUILD pager,
    # which confuse users and can abort the install.
    "$helper" -S --needed --skipreview -- "$@"
  fi
}

# Uninstall a list of packages. Only the ones actually installed are removed
# (the catalog groups may include packages you never installed). Uses pacman
# directly: AUR packages are regular packages once installed, so no helper is
# needed. pacman shows what it will remove and asks for confirmation.
uninstall_packages() {
  local -a present=(); local p
  for p in "$@"; do
    pacman -Qq -- "$p" >/dev/null 2>&1 && present+=("$p")
  done
  if [ "${#present[@]}" -eq 0 ]; then
    warn "$(t uninstall_none_installed)"; return 1
  fi
  printf '\n%s%s%s\n\n' "$C_B" "$(printf "$(t uninstall_with)" "${present[*]}")" "$C_RESET"
  if ! confirm "$(t confirm_uninstall)"; then
    warn "$(t uninstall_cancelled)"; return 1
  fi
  # -R remove, -n skip .pacsave backups, -s also remove now-unneeded deps.
  sudo pacman -Rns -- "${present[@]}"
}

# ==================================================================
#  Installation list (accumulates apps from several categories)
# ==================================================================
# A selection you build across categories and then act on in bulk: install
# ALL or uninstall ALL. It never forces you through it — in each category you
# can «Install now», «Uninstall» or «Add to the list» (direct flows vs. queue).
LIST_NAMES=()   # visible name of each entry
LIST_PKGS=()    # package(s) of each entry (parallel to LIST_NAMES)

list_add() { # $1 = visible name ; $2 = package(s)
  local name="$1" pkgs="$2" p
  for p in "${LIST_PKGS[@]}"; do
    [ "$p" = "$pkgs" ] && { warn "$(printf "$(t list_already)" "$name")"; return; }
  done
  LIST_NAMES+=("$name")
  LIST_PKGS+=("$pkgs")
  ok "$(printf "$(t list_added)" "$name")"
}

list_show() {
  local i
  for i in "${!LIST_NAMES[@]}"; do
    printf '  %s%2d)%s %-26s %s%s%s\n' \
      "$C_B" "$((i+1))" "$C_RESET" "${LIST_NAMES[$i]}" "$C_DIM" "${LIST_PKGS[$i]}" "$C_RESET"
  done
}

list_install() {
  local -a flat=(); local e
  for e in "${LIST_PKGS[@]}"; do flat+=($e); done   # split the package groups
  [ "${#flat[@]}" -eq 0 ] && { warn "$(t list_is_empty)"; return 1; }
  if install_packages "${flat[@]}"; then
    LIST_NAMES=(); LIST_PKGS=()
    ok "$(t list_done)"
  fi
}

list_uninstall() {
  local -a flat=(); local e
  for e in "${LIST_PKGS[@]}"; do flat+=($e); done   # split the package groups
  [ "${#flat[@]}" -eq 0 ] && { warn "$(t list_is_empty)"; return 1; }
  if uninstall_packages "${flat[@]}"; then
    LIST_NAMES=(); LIST_PKGS=()
    ok "$(t list_uninstall_done)"
  fi
}

list_menu() {
  while true; do
    if [ "${#LIST_NAMES[@]}" -eq 0 ]; then
      header "$(t list_title)"
      warn "$(t list_empty_hint)"
      pause; return
    fi
    local keys=(i u q v 0) labels=(
      "$(t list_install_all)" "$(t list_uninstall_all)" "$(t list_remove)" "$(t list_clear)" "$(t back)")
    MENU_INFO="$(list_show)"
    menu_pick "$(t list_title)" keys labels 0
    MENU_INFO=""
    case "$MENU_RESULT" in
      i|I) list_install; pause; [ "${#LIST_NAMES[@]}" -eq 0 ] && return ;;
      u|U) list_uninstall; pause; [ "${#LIST_NAMES[@]}" -eq 0 ] && return ;;
      q|Q)
        local n; read -rp "$(t list_remove_prompt)" n
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#LIST_NAMES[@]}" ]; then
          local name="${LIST_NAMES[$((n-1))]}"
          unset 'LIST_NAMES[$((n-1))]' 'LIST_PKGS[$((n-1))]'
          LIST_NAMES=("${LIST_NAMES[@]}"); LIST_PKGS=("${LIST_PKGS[@]}")
          ok "$(printf "$(t list_removed)" "$name")"
        else
          warn "$(t list_bad_num)"
        fi
        pause ;;
      v|V) LIST_NAMES=(); LIST_PKGS=(); ok "$(t list_cleared)"; pause; return ;;
      0|"") return ;;
      *) warn "$(t invalid_option)"; pause ;;
    esac
  done
}

