#!/usr/bin/env bash
#
# cachyos-assistant — CachyOS configuration assistant (JorgeLT)
#
# Interactive menu with sections:
#   1) Install applications (by category)
#   2) Configuration (fixes and tweaks, by category)
#   3) System status
#
# Fixes/tweaks rely on the 'cachyos-fix' script (same PATH).
#
# The UI is bilingual (English / Spanish). The chosen language is remembered
# in ~/.config/cachyos-toolkit/lang and can be changed from the main menu or
# overridden with the CACHYOS_LANG environment variable.
#
set -uo pipefail

# ------------------------------ Style -----------------------------
C_RESET=$'\033[0m'; C_B=$'\033[1m'
C_BLUE=$'\033[1;34m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'
C_RED=$'\033[1;31m'; C_CYAN=$'\033[1;36m'; C_DIM=$'\033[2m'

# ------------------------------ i18n ------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cachyos-toolkit"
LANG_FILE="$CONFIG_DIR/lang"
UI_LANG="en"          # resolved by load_lang()
LANG_SOURCE="default" # env | file | default

# Navigation mode: "arrows" (↑/↓ + Enter, numbers still work as shortcuts) or
# "numbers" (classic: type the number/letter). Remembered in $NAV_FILE.
NAV_FILE="$CONFIG_DIR/nav"
NAV_MODE="arrows"
NAV_SOURCE="default"  # env | file | default
load_nav() {
  if   [ -n "${CACHYOS_NAV:-}" ]; then NAV_MODE="$CACHYOS_NAV"; NAV_SOURCE="env"
  elif [ -r "$NAV_FILE" ];       then NAV_MODE="$(<"$NAV_FILE")"; NAV_SOURCE="file"
  else                                NAV_MODE="arrows"; NAV_SOURCE="default"; fi
  case "$NAV_MODE" in arrows|numbers) ;; *) NAV_MODE="arrows" ;; esac
}
save_nav() {
  mkdir -p "$CONFIG_DIR" 2>/dev/null || return 0
  printf '%s\n' "$NAV_MODE" > "$NAV_FILE" 2>/dev/null || true
}

# Guess the default language from the system locale (Spanish -> es, else en).
detect_system_lang() {
  case "${LC_ALL:-}${LC_MESSAGES:-}${LANG:-}" in
    es*|*_ES*|*es_*) echo es ;;
    *) echo en ;;
  esac
}

# Resolve the UI language: env override > saved file > system locale.
load_lang() {
  if [ -n "${CACHYOS_LANG:-}" ]; then
    UI_LANG="$CACHYOS_LANG"; LANG_SOURCE="env"
  elif [ -r "$LANG_FILE" ]; then
    UI_LANG="$(<"$LANG_FILE")"; LANG_SOURCE="file"
  else
    UI_LANG="$(detect_system_lang)"; LANG_SOURCE="default"
  fi
  case "$UI_LANG" in es|en) ;; *) UI_LANG="en" ;; esac
}

# Persist the chosen language so it is remembered next time.
save_lang() {
  mkdir -p "$CONFIG_DIR" 2>/dev/null || return 0
  printf '%s\n' "$UI_LANG" > "$LANG_FILE" 2>/dev/null || true
}

